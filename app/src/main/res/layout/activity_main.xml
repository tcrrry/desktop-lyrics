<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/overlay_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_ui_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="歌词悬浮窗"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/tv_runtime_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_ui_status_badge"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="准备就绪"
                    android:textColor="#FF7388"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_overlay_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="2dp"
                android:text="正在检查权限…"
                android:textColor="#ADB2C1"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_listener_permission"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_permission_button"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="通知使用权"
                    android:textAllCaps="false"
                    android:textColor="#F4F5F8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_overlay_permission"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_permission_button"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="悬浮窗权限"
                    android:textAllCaps="false"
                    android:textColor="#F4F5F8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_overlay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ui_primary_button"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="开启歌词悬浮窗"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/instruction_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ui_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="使用说明"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ui_resize_icon"
                    android:gravity="center"
                    android:text="↖"
                    android:textColor="#202333"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="缩放与查看"
                        android:textColor="#F8F8FA"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="单点切换标准 / 收起，双击进入全屏歌词，长按拖动自定义尺寸；展开态可旋转 90°。收起按钮会自动淡出，点悬浮窗唤出"
                        android:textColor="#989FAF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ui_resize_icon"
                    android:gravity="center"
                    android:text="≋"
                    android:textColor="#202333"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="歌词源与匹配"
                        android:textColor="#F8F8FA"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="单击切换歌词源，双击重新匹配并记忆，长按恢复自动；可在歌词源管理中预览和选择版本"
                        android:textColor="#989FAF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/update_notice_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_panel"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/update_notice_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="发现新版本"
                    android:textColor="#F8F8FA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/update_notice_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="#989FAF"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/update_view_button"
                        style="@style/SettingsAction"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="查看更新" />

                    <Button
                        android:id="@+id/update_later_button"
                        style="@style/SettingsAction"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="稍后" />

                    <Button
                        android:id="@+id/update_ignore_button"
                        style="@style/SettingsAction"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="忽略此版" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/version_check_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="当前版本 1.07 · 检查更新"
                android:textColor="#F7F7FA"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/background_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ui_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="动态背景"
                android:textColor="#F7F7FA"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="分别设置展开与收起形态的背景、字号和歌词颜色"
                android:textColor="#7F8798"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/settings_target_shell"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ui_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/settings_target_expanded"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_segment_selected"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="展开"
                    android:textColor="#202331"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/settings_target_compact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="收起"
                    android:textColor="#9DA4B5"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/background_mode_shell"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ui_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView android:id="@+id/background_mode_transparent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="透明" android:textColor="#9DA4B5" android:textSize="12sp" />
                <TextView android:id="@+id/background_mode_low" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="低负载" android:textColor="#9DA4B5" android:textSize="12sp" />
                <TextView android:id="@+id/background_mode_medium" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="中负载" android:textColor="#9DA4B5" android:textSize="12sp" />
                <TextView android:id="@+id/background_mode_high" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_ui_segment_selected" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="高负载" android:textColor="#202331" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/appearance_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ui_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="歌词设置"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="歌词字号"
                    android:textColor="#F7F7FA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/font_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#F7F7FA"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_font_size"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="3dp"
                android:max="115"
                android:progress="65"
                android:progressBackgroundTint="#39404F"
                android:progressTint="#FA2D48"
                android:splitTrack="false"
                android:thumbTint="#F7F7FA" />

            <Button
                android:id="@+id/btn_add_quick_tile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ui_pill"
                android:text="添加下拉快捷磁贴"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="小"
                    android:textColor="#767E90"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大"
                    android:textColor="#767E90"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="歌词偏移"
                    android:textColor="#F7F7FA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lyric_offset_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.0s"
                    android:textColor="#F7F7FA"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_lyric_offset"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="2dp"
                android:max="100"
                android:progress="50"
                android:progressBackgroundTint="#39404F"
                android:progressTint="#FA2D48"
                android:splitTrack="false"
                android:thumbTint="#F7F7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="当前偏移会按歌曲和歌词源分别记忆"
                android:textColor="#697184"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_manage_lyric_sources"
                    style="@style/SettingsAction"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="歌词源管理" />

                <Button
                    android:id="@+id/btn_manage_lyric_offsets"
                    style="@style/SettingsAction"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="偏移记忆管理" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="歌词颜色"
                android:textColor="#F7F7FA"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_ui_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/lyric_color_white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● 白"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lyric_color_blue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● 蓝"
                    android:textColor="#9FD8FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lyric_color_black"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● 黑"
                    android:textColor="#AEB3BF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lyric_color_pink"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="● 粉"
                    android:textColor="#FFB6D5"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2">
                    <TextView
                        android:id="@+id/lyric_stroke"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="描"
                        android:textColor="#FA2D48"
                        android:textSize="12sp" />
                </FrameLayout>
                <TextView
                    android:id="@+id/lyric_color_custom"
                    android:layout_width="0dp"
                    android:layout_weight="8"
                    android:layout_marginStart="6dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ui_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="无级调色 · #FFFFFF"
                    android:textColor="#F7F7FA"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="外语歌词"
                android:textColor="#F7F7FA"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_ui_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/translation_original"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="原文"
                    android:textColor="#9DA4B5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/translation_bilingual"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_segment_selected"
                    android:gravity="center"
                    android:text="双语"
                    android:textColor="#202331"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/translation_translated"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="中文"
                    android:textColor="#9DA4B5"
                    android:textSize="12sp" />

            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="点击“音”独立开关发音；显示歌词源提供的罗马音／读音，无数据时保留原歌词"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2">
                    <TextView
                        android:id="@+id/pronunciation_enabled"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="开启发音显示"
                        android:fontFamily="sans-serif-medium"
                        android:text="音"
                        android:textColor="#FA2D48"
                        android:textSize="12sp" />
                </FrameLayout>
                <Button
                    android:id="@+id/btn_supplement_translation"
                    style="@style/SettingsAction"
                    android:layout_width="0dp"
                    android:layout_weight="8"
                    android:layout_marginStart="6dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ui_pill"
                    android:text="补充翻译 · 语言包与 API"
                    android:textColor="#F7F7FA" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
